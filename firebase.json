{
  "hosting": {
    "public": "web",
    "ignore": ["firebase.json", ".firebaserc", "*.md", "*.py", "*.pyc", "__pycache__"],
    "predeploy": [
      "node /Users/ksmoon/Coding/quality-os/scripts/maintenance-toggle.mjs on INCENTIVE \"배포 중...\""
    ],
    "postdeploy": [
      "node /Users/ksmoon/Coding/quality-os/scripts/maintenance-toggle.mjs off INCENTIVE"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "region": "asia-northeast3",
      "ignore": [
        "node_modules",
        ".git"
      ]
    }
  ]
}
