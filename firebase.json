{
  "hosting": {
    "public": "web",
    "ignore": ["firebase.json", ".firebaserc", "*.md", "*.py", "*.pyc", "__pycache__"]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "region": "asia-northeast3",
      "ignore": [
        "node_modules",
        ".git"
      ]
    }
  ]
}
