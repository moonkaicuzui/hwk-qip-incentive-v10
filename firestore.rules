rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Admin user (authorized emails)
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email in ['ksmoon@hsvina.com', 'huynhnhurgqa04@hsvina.com'];
    }

    // Employee data: auth read, admin write
    match /employees/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Dashboard summary: auth read, admin write
    match /dashboard_summary/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Threshold settings: auth read, admin write
    match /thresholds/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Threshold change history: auth read, admin create only (immutable audit trail)
    match /threshold_history/{document} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
    }

    // Config settings (position mapping, talent pool, auditor areas, etc.)
    match /configs/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // System Feedback: auth users can create & read own, admin can read/write all
    match /systemFeedback/{document} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAdmin() ||
                       (isAuthenticated() && resource.data.createdBy.uid == request.auth.uid);
    }

    // Pending email notifications: auth users can create, admin can read/write
    match /pendingNotifications/{document} {
      allow create: if isAuthenticated();
      allow read, update: if isAdmin();
    }

    // System config: admin only
    match /system/{document} {
      allow read, write: if isAdmin();
    }

    // Default: deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
