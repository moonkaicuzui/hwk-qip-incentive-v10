rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Admin user — reads admin_emails from system/config dynamically
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email in get(/databases/$(database)/documents/system/config).data.admin_emails;
    }

    // Employee data: auth read, admin write
    match /employees/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Dashboard summary: auth read, admin write
    match /dashboard_summary/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Threshold settings: auth read, admin write
    match /thresholds/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Threshold change history: auth read, admin create only (immutable audit trail)
    match /threshold_history/{document} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
    }

    // Config settings (position mapping, talent pool, auditor areas, etc.)
    match /configs/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // System Feedback: auth users can create & read, admin can update, creator can update own
    // Collection name: system_feedback (snake_case convention)
    match /system_feedback/{document} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() ||
                       (isAuthenticated() && resource.data.createdBy.uid == request.auth.uid);
    }

    // Legacy collection name (backward compat)
    match /systemFeedback/{document} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() ||
                       (isAuthenticated() && resource.data.createdBy.uid == request.auth.uid);
    }

    // Pending email notifications: auth users can create, admin can read/write
    match /pendingNotifications/{document} {
      allow create: if isAuthenticated();
      allow read, update: if isAdmin();
    }

    // Email config: Cloud Functions read (server-side), admin write
    match /config/{document} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Email logs: Cloud Functions create (server-side bypasses rules), admin read only
    match /email_logs/{document} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }

    // System config: admin only (contains admin_emails list)
    // Note: isAdmin() reads this document, so we use a direct email check here
    // to avoid circular dependency. Update these emails when admins change.
    match /system/{document} {
      allow read: if isAuthenticated();
      allow write: if request.auth != null &&
                      request.auth.token.email in ['ksmoon@hsvina.com', 'huynhnhurgqa04@hsvina.com'];
    }

    // Allowances: auth read, admin write
    match /allowances/{monthYear}/items/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Default: deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
